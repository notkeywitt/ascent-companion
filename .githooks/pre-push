#!/bin/sh
# Refuses a direct push to main.
#
# main is production on Vercel. Only the lander (.github/workflows/lander.yml)
# pushes it, after it merges the queue and runs typecheck, tests, build and
# lint once. A session ships with `npm run ship`, which pushes to ready/<name>.
#
# Arm it on a fresh clone (once per machine; the session-start hook does it):
#   git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: main is production and only the lander pushes it. Run \`npm run ship\` instead." >&2
    exit 1
  fi
done
exit 0
