{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != main ] && [ \"$VERCEL_GIT_COMMIT_REF\" != preview ]",
  "crons": [
    {
      "path": "/api/digest/run",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/digest/run",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/google-chat/sync",
      "schedule": "41 10 * * *"
    }
  ]
}
