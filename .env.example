# JobTread Pave API (server-side only — never expose to the browser)
JT_GRANT_KEY=
JT_ORG_ID=22PXG7QcMaQ2

# Gemini (invoice extraction — powers the Add a Bill screen)
GEMINI_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # optional; defaults to the Apps Script engine's model

# Claude chat assistant (the /chat screen — read-only JobTread Q&A).
ANTHROPIC_API_KEY=
# Model for the assistant. Sonnet 5 is the recommended cost/speed pick for this
# high-volume chat surface; leave unset to fall back to the top-quality Opus 4.8.
ANTHROPIC_MODEL=claude-sonnet-5

# JobTread vendor mapping — Sunset's JT ACCOUNT id (Sunset bills keep their
# arrival date as the JT issue date; everyone else gets last-day-of-billing-month)
JT_SUNSET_VENDOR_ID=

# Auth allowlist (comma-separated Google accounts)
ALLOWED_EMAILS=office@ascentbuildingco.com,keillor@ascentbuildingco.com

# Master switch for ALL writes to JobTread. Leave unset/false until the write
# workflow is coordinated with the existing AppSheet flow. Set to "true" to arm.
COMPANION_WRITES_ENABLED=false

# Apps Script web app (Sheets/Drive-backed features: employees, tools, safety
# meetings, email logging, mileage). The Assistant has no Sheets client, so it
# POSTs {action, secret, ...} to this versioned /exec URL. The secret must equal
# Script Property SYNC_TRIGGER_SECRET on the Apps Script side.
APPS_SCRIPT_SYNC_URL=
APPS_SCRIPT_SYNC_SECRET=

# Google Maps Platform key for the Mileage tracker — used server-side by
# /api/mileage to turn the trip's start/end GPS points into driving miles + the
# street addresses. Enable the **Routes API** (driving miles) on the project;
# for the start/end addresses also enable the **Geocoding API** (optional —
# miles still work without it). NOT the legacy Directions API. Usage is tiny
# (a couple of calls per logged trip), well under the free credit.
GOOGLE_MAPS_API_KEY=

# Assistant database (non-billing data like RFIs). Local file by default; point
# at a hosted libSQL/Turso URL for deploy (with DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/companion.db
# DATABASE_AUTH_TOKEN=

# Shared-password auth (fallback / transition). Unset = OFF for local dev.
# APP_PASSWORD=

# Google sign-in (Auth.js). Google is used when AUTH_GOOGLE_ID is set; otherwise
# the app falls back to APP_PASSWORD. Create an OAuth client in Google Cloud with
# redirect URI https://<your-app>/api/auth/callback/google.
# AUTH_SECRET=            # random 32+ byte string (npx auth secret, or openssl rand -base64 32)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# ALLOWED_EMAILS=office@ascentbuildingco.com,keillor@ascentbuildingco.com
