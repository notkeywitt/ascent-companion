{
  "manifest_version": 3,
  "name": "Ascent Companion",
  "version": "0.3.0",
  "description": "JobTread companion side panel: coding queue + unbilled expenses.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Ascent Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://app.jobtread.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.jobtread.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
